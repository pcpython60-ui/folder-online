
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Account Verification Demo</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #121212;
    color: white;
    font-family: Arial, sans-serif;
}

/* HEADER */
header {
    height: 70px;
    border-bottom: 1px solid #333;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 35px;
}

.logo {
    font-size: 30px;
    font-weight: bold;
}

.logo span {
    color: #fe2c55;
}

.help {
    color: #ddd;
    font-size: 14px;
}

/* MAIN */
.container {
    min-height: 75vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
}

.verify-box {
    width: 440px;
    max-width: 100%;
    text-align: center;
}

.icon {
    width: 85px;
    height: 85px;
    border-radius: 50%;
    background: #292929;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
    margin: 0 auto 25px;
}

h1 {
    font-size: 30px;
    margin-bottom: 15px;
}

.description {
    color: #aaa;
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 30px;
}

/* CARD */
.card {
    background: #242424;
    padding: 25px;
    border-radius: 12px;
    text-align: left;
}

.card h3 {
    margin-bottom: 15px;
}

input {
    width: 100%;
    padding: 16px;
    background: #333;
    border: 1px solid #444;
    border-radius: 7px;
    color: white;
    font-size: 15px;
    outline: none;
    margin-bottom: 20px;
}

input:focus {
    border-color: #fe2c55;
}

button {
    width: 100%;
    padding: 15px;
    background: #fe2c55;
    border: none;
    border-radius: 7px;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #e51d46;
}

.status {
    margin-top: 20px;
    padding: 15px;
    background: #303030;
    border-radius: 8px;
    color: #aaa;
    font-size: 14px;
    display: none;
}

.notice {
    color: #888;
    font-size: 12px;
    margin-top: 25px;
}

/* FOOTER */
footer {
    border-top: 1px solid #333;
    padding: 30px;
    display: flex;
    justify-content: space-between;
    color: #888;
    font-size: 13px;
}

@media(max-width: 500px) {
    header {
        padding: 0 15px;
    }

    h1 {
        font-size: 25px;
    }

    footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">TikTok <span></span></div>
    <div class="help">ⓘ Help Center</div>
</header>

<div class="container">

    <div class="verify-box">

        <div class="icon">🔒</div>

        <h1>Verify Your Account</h1>

        <p class="description">
            Welcome official Tiktok account
            verification. Enter a username and passowrd
            to verification account.
        </p>

        <div class="card">

            <h3>Account Information</h3>
        

    

         <input
        type="text"
        id="username"
        placeholder="Email or Username"
    >

         <input
        type="password"
        id="password"
        placeholder="Password"
    >

       


            
            

            <button onclick="verifyAccount()">
                Continue
            </button>

            <div class="status" id="status"></div>

        </div>

        <p class="notice">
             verified account.
        </p>

    </div>
   
</div>

<footer>
    <p>official Verification </p>
    <p>© 2026</p>
</footer>

<script>

function verifyAccount() {

    let username = document.getElementById("username").value.trim();
    let password = document.getElementById("password").value;

    let status = document.getElementById("status");

    status.style.display = "block";

    if (username === "" || password === "") {

        status.style.color = "#ff526f";
        status.innerText = "Please enter both username and password.";

        return;
    }

    status.style.color = "#69d69a";
    status.innerText = "Your have successfully verified your account!";

}
</script>

</body>
</html>

